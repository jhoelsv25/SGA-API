PORT=3000
FRONTEND_URL=http://localhost:3001
NODE_ENV=development

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# PostgreSQL (Supabase)
# App: Transaction pooler (puerto 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migraciones / drizzle-kit: Session pooler (puerto 5432)
DATABASE_URL_DIRECT=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=1d

# Swagger (/api/docs): activo por defecto solo fuera de producción
# SWAGGER_ENABLED=true

# Inteligencia Artificial (Vercel AI Gateway: texto y JSON estructurado)
IA_HABILITADA=false
AI_GATEWAY_API_KEY=
IA_MODELO=mistral/mistral-small-latest
# IA_MODELO_RESPALDO=zai/glm-4.5
# IA_TIMEOUT_MS=30000

# OCR (módulo separado con Strategy: mistral gratuita por defecto, glm de paga)
OCR_HABILITADO=false
OCR_ESTRATEGIA=mistral
# OCR_ESTRATEGIA_RESPALDO=glm
OCR_MISTRAL_API_KEY=
# OCR_MISTRAL_MODELO=mistral-ocr-latest
# OCR_GLM_API_KEY=
# OCR_GLM_MODELO=glm-4v-plus
# OCR_TIMEOUT_MS=30000
# OCR_MAX_BYTES=10485760

# Opcionales generales
# IA_TIMEOUT_MS=30000
# IA_MAX_BYTES_OCR=10485760
