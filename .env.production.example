# ============================================================
# SGA API (Backend NestJS) - Variables de Entorno Producción
# ============================================================
# Copiar como .env.production (o .env) si despliegas el backend por separado:
# cp .env.production.example .env.production

PORT=3000
NODE_ENV=production
FRONTEND_URL=https://intranet.colegiocarmelinas.edu.pe

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql://sga_admin:fff@postgres:5432/sga_colegio_db?sslmode=disable
DATABASE_URL_DIRECT=postgresql://sga_admin:43434@postgres:5432/sga_colegio_db?sslmode=disable

# ------------------------------------------------------------
# Redis (BullMQ y Caché)
# ------------------------------------------------------------
REDIS_URL=redis://:44433@redis:6379

# ------------------------------------------------------------
# Seguridad y Tokens JWT
# ------------------------------------------------------------
# Generar una clave de al menos 32 caracteres aleatorios:
# openssl rand -base64 32
JWT_SECRET=dffddfdf
JWT_EXPIRES_IN=1d

# Documentación OpenAPI (/api/docs): recomendado desactivar en producción
SWAGGER_ENABLED=false

# ------------------------------------------------------------
# Web Push (VAPID)
# ------------------------------------------------------------
# Generar claves con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@carmelinas.edu.pe
