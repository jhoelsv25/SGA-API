# ============================================================
# SGA API (Backend NestJS) - Variables de Entorno Producción
# ============================================================
# Copiar como .env.production (o .env) si despliegas el backend por separado:
# cp .env.production.example .env.production

PORT=3000
NODE_ENV=production
FRONTEND_URL=https://intranet.colegiocarmelinas.edu.pe

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql://sga_admin:GenerarUnaClaveMuySegura_Postgres_2026_XYZ@postgres:5432/sga_colegio_db?sslmode=disable
DATABASE_URL_DIRECT=postgresql://sga_admin:GenerarUnaClaveMuySegura_Postgres_2026_XYZ@postgres:5432/sga_colegio_db?sslmode=disable

# ------------------------------------------------------------
# Redis (BullMQ y Caché)
# ------------------------------------------------------------
REDIS_URL=redis://:GenerarUnaClaveMuySegura_Redis_2026_ABC@redis:6379

# ------------------------------------------------------------
# Seguridad y Tokens JWT
# ------------------------------------------------------------
# Generar una clave de al menos 32 caracteres aleatorios:
# openssl rand -base64 32
JWT_SECRET=super_secret_jwt_key_colegio_32_characters_random_string_here
JWT_EXPIRES_IN=1d

# Documentación OpenAPI (/api/docs): recomendado desactivar en producción
SWAGGER_ENABLED=false
